---
import FunnelLayout from "../layouts/FunnelLayout.astro";
---

<FunnelLayout title="Terms | AgenticFunnel Starter" description="Starter terms placeholder.">
  <main class="legal-page">
    <article class="legal-card">
      <p class="legal-eyebrow">Legal placeholder</p>
      <h1>Terms</h1>
      <p>
        This page is starter content only and is not legal advice. Replace it with terms that
        match your company, jurisdiction, products, refund policy, tax obligations, and support process.
      </p>
      <h2>What to include</h2>
      <ul>
        <li>Seller identity and contact details.</li>
        <li>Product description, pricing, taxes, and payment methods.</li>
        <li>Delivery rules for digital products and download links.</li>
        <li>Refund, cancellation, chargeback, and dispute policies.</li>
        <li>Customer responsibilities and acceptable use.</li>
      </ul>
    </article>
  </main>
</FunnelLayout>
