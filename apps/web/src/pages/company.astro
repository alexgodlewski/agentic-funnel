---
import FunnelLayout from "../layouts/FunnelLayout.astro";
---

<FunnelLayout title="Company | AgenticFunnel Starter" description="Starter company information placeholder.">
  <main class="legal-page">
    <article class="legal-card">
      <p class="legal-eyebrow">Company placeholder</p>
      <h1>Company Information</h1>
      <p>
        Replace this page with your registered business name, address, tax identifier,
        support email, and any legally required seller disclosures before launch.
      </p>
      <dl class="company-details">
        <dt>Business name</dt>
        <dd>Your Company LLC</dd>
        <dt>Support email</dt>
        <dd>support@example.com</dd>
        <dt>Website</dt>
        <dd>example.com</dd>
      </dl>
    </article>
  </main>
</FunnelLayout>
