---
import FunnelLayout from "../layouts/FunnelLayout.astro";
---

<FunnelLayout title="Privacy | AgenticFunnel Starter" description="Starter privacy placeholder.">
  <main class="legal-page">
    <article class="legal-card">
      <p class="legal-eyebrow">Legal placeholder</p>
      <h1>Privacy Policy</h1>
      <p>
        This page is starter content only and is not legal advice. Replace it with a policy that
        reflects your actual data collection, processors, analytics tools, email providers, retention,
        user rights, and cookie consent implementation.
      </p>
      <h2>Default data surfaces</h2>
      <ul>
        <li>Lead and checkout details submitted by the buyer.</li>
        <li>Stripe payment identifiers and webhook receipts.</li>
        <li>Download token and fulfillment events.</li>
        <li>Optional PostHog, Meta, Hyros, Mailgun, and MailerLite events when configured.</li>
      </ul>
    </article>
  </main>
</FunnelLayout>
