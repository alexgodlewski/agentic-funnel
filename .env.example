NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentic_funnel
PUBLIC_APP_URL=http://localhost:4321

# Required for real checkout testing.
# Create test Products + Prices in Stripe, then fill these values and run:
# pnpm --filter @agentic-funnel/web sync:stripe
STRIPE_MODE=test
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_TEST_SECRET_KEY=sk_test_replace_me
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_TEST_WEBHOOK_SECRET=whsec_replace_me
STRIPE_TEST_PRICE_CORE=price_replace_core
STRIPE_TEST_PRICE_ORDER_BUMP_1=price_replace_templates
STRIPE_TEST_PRICE_ORDER_BUMP_2=price_replace_audio
STRIPE_TEST_PRICE_OTO=price_replace_workshop
STRIPE_TEST_PRICE_DOWNSELL=price_replace_quickstart

# Fill before production. Switch STRIPE_MODE=live when ready.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PRICE_CORE=
STRIPE_LIVE_PRICE_ORDER_BUMP_1=
STRIPE_LIVE_PRICE_ORDER_BUMP_2=
STRIPE_LIVE_PRICE_OTO=
STRIPE_LIVE_PRICE_DOWNSELL=

# Optional analytics and ad attribution. Leave blank for local development.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
PUBLIC_HYROS_TRACKING_DOMAIN=
PUBLIC_HYROS_PROPERTY_HASH=
HYROS_API_KEY=

# Optional transactional email. Leave blank locally; worker mail jobs no-op.
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN_TX=
MAILGUN_FROM_TX=
MAILGUN_REPLY_TO=

# Optional marketing automation. Missing keys skip only the matching assignment.
MAILERLITE_API_TOKEN=
MAILERLITE_SHOP_ID=
MAILERLITE_GROUPS_JSON={"leads_all":"","leads_customers":"","leads_lead_nurture":"","leads_not_bought_bump_1":"","leads_not_bought_bump_2":"","leads_not_bought_oto":"","leads_not_bought_downsell":""}

# Local MinIO from compose.yaml. For production, replace with S3/R2/Spaces.
ASSET_BUCKET=downloads
ASSET_REGION=us-east-1
ASSET_ENDPOINT=http://localhost:9000
ASSET_ACCESS_KEY_ID=minioadmin
ASSET_SECRET_ACCESS_KEY=minioadmin
ASSET_LINK_TTL_SECONDS=604800

APP_SIGNING_SECRET=replace-with-at-least-32-characters
POST_PURCHASE_WINDOW_MINUTES=10
WORKER_HEALTH_PORT=8788
